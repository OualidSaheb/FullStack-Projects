# Postgres connection. Leave empty to use the embedded PGlite database (./data/pglite).
DATABASE_URL=
# Long random string: signs sessions and encrypts the Yalidine token.
APP_SECRET=change-me-to-a-long-random-string
# Public URL of the CRM (used in the Apps Script and the Yalidine webhook URL).
PUBLIC_URL=http://localhost:3000
PORT=3000
# First admin account (created on first start only).
ADMIN_EMAIL=admin@touraya.local
ADMIN_PASSWORD=
